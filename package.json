{
  "name": "bento-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --dir apps/bento dev",
    "build": "pnpm --dir apps/bento build",
    "test": "pnpm --dir apps/bento test",
    "lint": "pnpm --dir apps/bento lint",
    "preview": "pnpm --dir apps/bento preview",
    "dev:web": "pnpm --dir apps/bento dev:web",
    "smoke:acp": "pnpm --dir apps/bento smoke:acp",
    "dist": "pnpm --dir apps/bento dist",
    "dist:dir": "pnpm --dir apps/bento dist:dir",
    "pack:check": "pnpm --dir apps/bento exec electron-builder --mac dir --publish never -c.mac.identity=null",
    "dev:website": "pnpm --dir apps/website dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "patchedDependencies": {
      "@earendil-works/pi-coding-agent": "patches/@earendil-works__pi-coding-agent.patch"
    }
  }
}
