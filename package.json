{
  "name": "bento",
  "description": "Local-first multi-harness agent workbench",
  "author": "Bento Contributors",
  "license": "MIT",
  "private": true,
  "version": "0.4.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "postinstall": "node scripts/ensure-node-pty.mjs",
    "preview": "vite preview",
    "dev:web": "BENTO_WEB=1 vite",
    "smoke:acp": "node scripts/acp-smoke.mjs",
    "dist": "pnpm build && electron-builder --mac && touch release/.metadata_never_index",
    "dist:dir": "pnpm build && electron-builder --mac dir && touch release/.metadata_never_index"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.2.112",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview": "^8.2.0",
    "dockview-react": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fix-path": "^5.0.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "smol-toml": "^1.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "patchedDependencies": {
      "@earendil-works/pi-coding-agent": "patches/@earendil-works__pi-coding-agent.patch"
    }
  },
  "build": {
    "appId": "dev.bento.workbench",
    "productName": "Bento",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/mcp-http-relay.mjs",
      "electron/pi-mcp-extension.mjs",
      "package.json",
      "!node_modules/@earendil-works/pi-tui/native/win32/**",
      "!node_modules/@earendil-works/pi-tui/native/darwin/prebuilds/darwin-x64/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/bento-icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "billc8128",
        "repo": "bento"
      }
    ]
  },
  "main": "dist-electron/main.js"
}
